+class _Resp:
+    """兼容 genai 响应的最小包装"""
+
+    def __init__(self, text: str):
+        self.text = text
+
+
+class _RespModels:
+    def __init__(self, client):
+        self._client = client
+
+    def generate_content(self, model: str, contents: str, **kwargs) -> _Resp:
+        # genai prompt 中 system + 用户内容在同一段文本里，直接作为 user 消息发送
+        resp = self._client.chat.completions.create(
+            model=model,
+            messages=[{"role": "user", "content": contents}],
+            temperature=kwargs.get("temperature", 0.3),
+            stream=False,
+        )
+        choice = resp.choices[0] if resp.choices else None
+        text = (getattr(getattr(choice, "message", None), "content", None) or "").strip()
+        if not text and getattr(choice, "finish_reason", "") == "length":
+            raise RuntimeError("DeepSeek 返回被 max_tokens 截断")
+        return _Resp(text)
+
+
+class _RespModelsProxy:
+    def __init__(self, models):
+        self.models = models
+
+
